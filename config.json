{
  "default_profile": "browser_logins",
  "profiles": {
    "browser_logins": {
      "name": "Browser Logins",
      "hotkeys": {
        "ctrl+alt+f": {
          "app_filter": "firefox",
          "actions": [
            { "type": "type", "text": "user@example.com" },
            { "type": "key", "key": "tab" },
            { "type": "delay", "duration": 0.2 },
            { "type": "type", "text": "Password123" },
            { "type": "key", "key": "enter" }
          ],
          "delay": 0.1
        },
        "ctrl+alt+g": {
          "app_filter": "google-chrome",
          "actions": [
            { "type": "type", "text": "user@gmail.com" },
            { "type": "key", "key": "tab" },
            { "type": "delay", "duration": 0.2 },
            { "type": "type", "text": "Password123" },
            { "type": "key", "key": "enter" }
          ],
          "delay": 0.1
        }
      }
    },
    "general_shortcuts": {
      "name": "General Shortcuts",
      "hotkeys": {
        "ctrl+alt+t": {
          "actions": [
            { "type": "launch", "app": "gnome-terminal" }
          ],
          "delay": 0.1
        }
      }
    }
  }
}
